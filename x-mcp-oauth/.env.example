# X Developer Portal > Projects & Apps > 対象App > Keys and tokens > OAuth 2.0 Client ID and Client Secret
X_CLIENT_ID=

# Type of App が Web App / Automated App or Bot（= Confidential client）なら必須。
# Native App（= Public client）なら空のままにする。ここの取り違えが 401 の主因。
X_CLIENT_SECRET=

# Developer Portal の User authentication settings > Callback URI と1バイト単位で完全一致させる。
# 末尾スラッシュ、http/https、ポート番号、大文字小文字、すべて一致が条件。
X_REDIRECT_URI=http://127.0.0.1:8765/callback

# 半角スペース区切り。カンマ区切りは不可。
# offline.access を外すと Refresh Token が発行されない。
X_SCOPES=tweet.read tweet.write users.read offline.access

# S256 推奨。plain は検証用途のみ。
X_CODE_CHALLENGE_METHOD=S256
